{
  "name": "comp0",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @comp0/docs dev",
    "docs:screenshot": "node scripts/screenshot-docs.mjs",
    "format": "oxfmt --write --ignore-path .oxfmtignore \"**/*.{ts,tsx,js,json,css,html,md,yaml}\" && pnpm docs:format-code",
    "format:check": "oxfmt --check --ignore-path .oxfmtignore \"**/*.{ts,tsx,js,json,css,html,md,yaml}\" && pnpm docs:check-code",
    "docs:format-code": "node scripts/format-docs-code.mjs",
    "docs:check-code": "node scripts/format-docs-code.mjs --check",
    "lint": "oxlint -c oxlint.config.ts packages/core/src packages/react/src packages/react/test apps/docs/src apps/docs/vite.config.ts apps/docs/react-router.config.ts vitest.config.ts vitest.browser.setup.ts vitest.setup.ts --no-ignore --deny-warnings --report-unused-disable-directives",
    "test": "vitest run --project unit",
    "test:all": "vitest run",
    "test:browser": "vitest run --project browser",
    "test:compiler-smoke": "pnpm build && pnpm test:compiler-conformance && node packages/react/test/verify-react-compiler.mjs",
    "test:package": "node scripts/verify-packages.mjs",
    "typecheck": "tsgo -p tsconfig.typecheck.json",
    "test:compiler-conformance": "node scripts/compare-react-compilers.mjs",
    "test:docs": "node scripts/verify-docs-runtime.mjs",
    "test:connect": "node scripts/verify-connect-runtime.mjs",
    "test:docs:mobile": "node scripts/verify-docs-mobile.mjs",
    "test:connect:touch": "node scripts/verify-connect-touch.mjs"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.0",
    "axe-core": "4.13.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "jsdom": "30.0.1",
    "oxc-transform-react": "0.148.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "playwright": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
